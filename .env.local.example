# MongoDB Atlas connection string.
#
# 기존 Express 블로그(forum)는 이 값을 코드에서 조립했다: 계정 daejincnc2, 클러스터
# nodeblog.jreokmg.mongodb.net을 하드코딩해두고 .env의 DB_PASSWORD만 비밀번호로 채워
# `mongodb+srv://daejincnc2:${DB_PASSWORD}@nodeblog.jreokmg.mongodb.net/?appName=NodeBlog`
# 형태로 만들었다. next-blog는 조립하지 않고 완성된 연결 문자열을 그대로 받으므로,
# forum의 DB_PASSWORD 값을 그대로 가져와 아래처럼 직접 조립해서 넣는다:
#   mongodb+srv://daejincnc2:<forum의 DB_PASSWORD 값>@nodeblog.jreokmg.mongodb.net/next-blog?appName=NodeBlog
# <db 이름>은 기존 forum 데이터와 섞이지 않도록 next-blog처럼 새 이름을 쓰는 걸 권장
# (같은 클러스터, 다른 데이터베이스로 분리됨 — 클러스터를 새로 만들 필요는 없음).
MONGODB_URI=

# forum이 쓰던 다른 env 변수(SESSION_SECRET, EMAIL_PASSWORD, PORT, S3_ARN, DOCKER_*, EC2_*)는
# next-blog에 대응 기능이 없어 가져올 필요 없다 — 세션/이메일 인증/Docker+EC2 배포 파이프라인이
# 아직 없음. S3_ACCESS_KEY/S3_ACCESS_SECRET_KEY는 아래 이미지 업로드 섹션에서 재사용한다.

# 글쓰기 에디터(components/WritePostForm.tsx)에서 이미지를 붙여넣거나 파일로 선택하면 S3에
# 업로드하고 그 URL을 마크다운에 자동으로 끼워 넣는다(lib/uploadImage.ts). forum이 쓰던 것과
# 같은 버킷/자격증명을 재사용하되(MONGODB_URI를 forum 클러스터로 재사용한 것과 동일한 패턴),
# next-posts/ 라는 별도 prefix를 써서 forum이 올린 이미지와 안 섞이게 분리한다.
# forum의 .env에 있던 S3_ACCESS_KEY / S3_ACCESS_SECRET_KEY 값을 그대로 옮겨 적는다.
S3_ACCESS_KEY=
S3_ACCESS_SECRET_KEY=
S3_BUCKET=nodeblogforum0530
S3_REGION=ap-southeast-2

# 댓글은 giscus(GitHub Discussions 기반, components/GiscusComments.tsx). 아래 값이 비어있으면
# 에러 대신 설정 안내 문구만 보여줌(forum에는 대응 값 없음 — 새로 발급).
# 1) 이 값들을 채울 GitHub 저장소가 Public이어야 하고, 그 저장소 Settings -> General ->
#    Features -> Discussions 를 켜둔다(기본 꺼져있음).
# 2) https://giscus.app 접속 -> "저장소" 칸에 <계정>/<저장소> 입력(giscus 앱이 그 저장소에
#    설치돼 있는지 자동으로 확인해줌, 안 돼있으면 설치 링크가 뜸).
# 3) "Discussion 카테고리"에서 댓글 전용 카테고리를 하나 고른다(기존 카테고리 재사용보다
#    새로 "Comments" 카테고리를 만들어 쓰는 걸 권장 — 다른 Discussion과 안 섞이게).
# 4) 폼 맨 아래에 자동 생성되는 <script> 설정에서 data-repo/data-repo-id/data-category/
#    data-category-id 값을 그대로 아래 4개에 옮겨 적는다.
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# 글 수정/삭제를 소유자 본인만 할 수 있도록 GitHub OAuth로 로그인 게이트를 건다(auth.ts).
# 1) `openssl rand -base64 33` 실행해서 나온 값을 아래에 채운다(JWT 서명용 랜덤 값).
#    Auth.js 문서의 `npx auth secret`은 쓰지 말 것 — npm의 이름이 같은 무관한 패키지로
#    연결돼 엉뚱한 BETTER_AUTH_SECRET 값을 출력하는 걸 실제로 확인함.
AUTH_SECRET=
# 2) GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#    콜백 URL은 반드시 <해당 환경의 origin>/api/auth/callback/github 형태여야 함.
#    로컬 개발: http://localhost:3000/api/auth/callback/github
#    프로덕션 배포 후: https://chorock.page/api/auth/callback/github (별도 OAuth App으로 새로 발급,
#    콜백 URL이 앱마다 고정이라 dev/prod 겸용 불가 — Vercel 환경변수에는 그 앱의 값을 넣는다)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 3) 로그인을 허용할 GitHub 계정의 사용자명(로그인 아이디) — 이 값과 다른 GitHub 계정은
#    로그인 자체가 거부됨(auth.ts의 signIn 콜백). 예: ChoRockKim
AUTH_OWNER_GITHUB_LOGIN=
